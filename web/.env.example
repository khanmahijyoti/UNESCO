# Copy this file to `web/.env` and fill it in. `.env` is gitignored.
#
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows)
#
# Every value here is safe to share with collaborators. None is a secret.
# If you ever find yourself pasting a key that starts with `service_role`
# or `sb_secret_`, stop — that key must never reach this file or the
# browser bundle. The build refuses to ship one.


# Where the deployed site lives. Only used to generate QR codes for the
# printed deck, so leave it unset while developing: the build then points
# codes at your own machine over HTTPS and you can scan them from a phone.
BASE_URL=https://scintillating-pavlova-53a769.netlify.app/


# Supabase project, for the multiplayer room system.
# Leave both blank and the QR companion still builds fine — room.html is
# simply not emitted.
#
# Find them in: Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://rtruzqnfhbaamjtsyzwd.supabase.co
SUPABASE_KEY=sb_publishable_6E_d_LvYvoBM0Ajw-_Ixnw_AS_IO4QW


# Local preview port. serve.js listens on this for http (localhost) and
# PORT+1 for https (phone scanning over the LAN).
PORT=8070
